    "@types/react-dom": "19.1.9",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.2",
